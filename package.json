{
  "name": "trf",
  "version": "0.0.0",
  "private": true,
  "description": "Recurring UPI AutoPay donations for The Rupee Fund — a FOSS United Foundation program, on Cloudflare Workers + D1.",
  "keywords": [
    "cloudflare-workers",
    "d1",
    "donations",
    "foss-united",
    "razorpay"
  ],
  "license": "MIT",
  "author": "FOSS United Foundation",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:live": "PUBLIC_SITE_ENV=live node scripts/build.mjs",
    "build:beta": "PUBLIC_SITE_ENV=beta node scripts/build.mjs",
    "preview": "PUBLIC_ALLOW_TEST_SITEKEY=true PUBLIC_TURNSTILE_SITEKEY=1x00000000000000000000AA astro build && wrangler dev --var TURNSTILE_HOSTNAMES:example.com --var TURNSTILE_ACTION: --var TURNSTILE_SECRET:1x0000000000000000000000000000000AA",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && wrangler d1 migrations apply trf-rupeefund --local",
    "cf-typegen": "wrangler types",
    "typecheck": "pnpm run cf-typegen && tsc -b tsconfig.build.json",
    "deploy:live": "pnpm run build:live && wrangler deploy",
    "deploy:beta": "pnpm run build:beta && wrangler deploy --env beta",
    "test": "vitest run",
    "test:e2e": "playwright test --project live --project live-no-js",
    "test:e2e:ui": "playwright test --ui",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --ignore-path .gitignore && prettier --write .",
    "format:check": "oxfmt --ignore-path .gitignore --check && prettier --check .",
    "check": "pnpm run cf-typegen && oxlint && tsc -b tsconfig.build.json && astro check && vitest run",
    "list:export": "node scripts/list-export.mts"
  },
  "dependencies": {
    "hono": "^4.13.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.3",
    "@cloudflare/workers-types": "^5.20260816.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "astro": "^7.2.2",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  },
  "engines": {
    "node": ">=22.18.0 <23.0.0 || >=23.6.0"
  },
  "packageManager": "pnpm@11.8.0"
}
