---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { LAUNCH_LIVE } from "../lib/launch.ts";
import { REMOVAL_ADDRESS } from "../lib/contact.ts";
import { TURNSTILE_ACTION, getSitekey } from "../lib/turnstile.ts";

const TURNSTILE_SITEKEY = getSitekey();

const TIERS = [10, 50, 100, 500, 1000] as const;
const DEFAULT_TIER = 100;

const inputClass =
  "w-full px-3 py-2 text-sm border border-ink/15 rounded-lg focus:ring-2 focus:ring-brand-fg focus:border-transparent outline-none";
const labelClass = "block text-xs font-semibold text-ink-2 mb-1";
const submitBtn =
  "w-full bg-brand-fg text-white py-3 rounded-lg font-semibold hover:bg-brand-900 transition duration-150 ease-out active:scale-[0.99] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-fg focus-visible:ring-offset-2 focus-visible:ring-offset-white";
const policyLink =
  "text-brand-fg underline decoration-transparent hover:decoration-brand transition-colors duration-150 ease-out rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-fg/50";
---

<Base>
  <div class="min-h-screen screen-enter">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="subscribe-card bg-white rounded-lg border border-ink/10 shadow-soft p-6">
        <div class="text-center mb-6">
          <div class="inline-block p-3 bg-brand-50 rounded-lg mb-3">
            <Icon name="heart" class="text-brand-fg" size={28} fill="currentColor" />
          </div>
          <h1 class="text-2xl font-bold text-ink mb-2 tracking-tight">Become a Founding Contributor</h1>
          <p class="text-ink-2 text-sm">
            {
              LAUNCH_LIVE
                ? "Recurring support for Indian open source, from ₹10/month. Set up UPI AutoPay — cancel anytime."
                : "Recurring support for Indian open source, from ₹10/month. Join the waitlist — we'll email you to set up UPI AutoPay when Season 1 opens at IndiaFOSS 2026."
            }
          </p>
        </div>

        {
          LAUNCH_LIVE ? (
            <form id="autopay-form" class="space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="autopay-name" class={labelClass}>
                    Full Name *
                  </label>
                  <input id="autopay-name" name="name" type="text" placeholder="Your name" class={inputClass} required />
                </div>
                <div>
                  <label for="autopay-mobile" class={labelClass}>
                    Mobile Number *
                  </label>
                  <input id="autopay-mobile" name="mobile" type="tel" placeholder="+91 98765 43210" class={inputClass} required />
                </div>
              </div>
              <div>
                <label for="autopay-email" class={labelClass}>
                  Email Address *
                </label>
                <input id="autopay-email" name="email" type="email" placeholder="your.email@example.com" class={inputClass} required />
              </div>
              <div>
                <label for="autopay-pan" class={labelClass}>
                  PAN Number *
                </label>
                <input id="autopay-pan" name="pan" type="text" placeholder="ABCDE1234F" class={`${inputClass} uppercase font-mono`} maxlength="10" required />
              </div>
              <div>
                <label for="autopay-address" class={labelClass}>
                  Contact Address *
                </label>
                <textarea id="autopay-address" name="address" placeholder="Street, City, State, PIN" rows="2" class={`${inputClass} resize-none`} required />
              </div>
              <p class="text-xs text-ink-3">
                PAN and address let FOSS United Foundation issue 80G tax benefits via its annual filing (Form 10BD). Held by the Foundation and shared with our payment processor — not stored by this site.
              </p>

              <fieldset>
                <legend class="block text-xs font-semibold text-ink-2 mb-1">Monthly Contribution (₹) *</legend>
                <input type="hidden" name="tier" id="tier-value" value={String(DEFAULT_TIER)} />
                <div class="flex flex-wrap gap-2" id="tier-group">
                  {TIERS.map((tier) => {
                    const selected = tier === DEFAULT_TIER;
                    const cls = selected
                      ? "border-brand bg-brand-50 text-brand-900"
                      : "border-ink/20 hover:border-brand hover:text-brand-fg";
                    return (
                      <button
                        type="button"
                        data-tier={tier}
                        aria-pressed={selected ? "true" : "false"}
                        class={`px-3 py-2 text-xs font-mono border rounded-md transition duration-150 ease-out active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-fg focus-visible:ring-offset-1 ${cls}`}
                      >
                        ₹{tier}
                      </button>
                    );
                  })}
                </div>
              </fieldset>

              <div class="bg-card border-l-4 border-brand rounded-r-lg p-3">
                <div class="flex gap-2">
                  <Icon name="alert" class="text-brand-fg flex-shrink-0 mt-0.5" size={16} />
                  <div class="text-xs text-ink-2">
                    <p class="font-semibold mb-1 text-ink">Early-bird UPI AutoPay</p>
                    <p>Set up a UPI AutoPay mandate you can cancel anytime. Your first contribution is collected when Season 1 opens.</p>
                  </div>
                </div>
              </div>

              <div class="flex items-start gap-2 bg-card p-3 rounded-lg border border-ink/10 shadow-soft">
                <input type="checkbox" id="terms" name="terms" class="mt-1 w-4 h-4 accent-brand border-ink/20 rounded" required />
                <label for="terms" class="text-xs text-ink-2 leading-relaxed">
                  I authorize FOSS United Foundation to collect my recurring contribution via UPI AutoPay, and accept the{" "}
                  <a href="https://fossunited.org/terms-of-service" target="_blank" rel="noopener noreferrer" class={policyLink}>
                    Terms
                  </a>
                  ,{" "}
                  <a href="https://fossunited.org/privacy-policy" target="_blank" rel="noopener noreferrer" class={policyLink}>
                    Privacy Policy
                  </a>{" "}
                  and{" "}
                  <a href="https://fossunited.org/refund-transfer-policy" target="_blank" rel="noopener noreferrer" class={policyLink}>
                    Refund Policy
                  </a>
                  .
                </label>
              </div>

              <label class="flex items-start gap-2 text-xs text-ink-2">
                <input type="checkbox" name="newsletter" checked class="mt-0.5 w-4 h-4 accent-brand border-ink/20 rounded" />
                Email me occasional Rupee Fund updates. Unsubscribe anytime.
              </label>
              <p id="autopay-error" class="text-xs text-red-600 text-center" role="alert" />
              <button type="submit" id="autopay-submit" class={`${submitBtn} disabled:opacity-60 disabled:pointer-events-none`}>
                Set Up UPI AutoPay
              </button>
              <p class="text-xs text-ink-3 text-center">Processed securely by Razorpay · Cancel anytime · India only</p>
            </form>
          ) : (
            <Fragment>
              <form id="waitlist-form" class="space-y-4" action="/api/waitlist" method="post">
                <div>
                  <label for="waitlist-name" class={labelClass}>
                    Full Name *
                  </label>
                  <input id="waitlist-name" name="name" type="text" placeholder="Your name" class={inputClass} required />
                </div>
                <div>
                  <label for="waitlist-email" class={labelClass}>
                    Email Address *
                  </label>
                  <input id="waitlist-email" name="email" type="email" placeholder="your.email@example.com" class={inputClass} required />
                </div>
                <div class="bg-card border-l-4 border-brand rounded-r-lg p-3">
                  <div class="flex gap-2">
                    <Icon name="bell" class="text-brand-fg flex-shrink-0 mt-0.5" size={16} />
                    <div class="text-xs text-ink-2">
                      <p class="font-semibold mb-1 text-ink">No payment yet</p>
                      <p>We'll email you when Season 1 opens at IndiaFOSS 2026 (26–27 September), so you can set up UPI AutoPay first.</p>
                    </div>
                  </div>
                </div>
                <div class="hidden" aria-hidden="true">
                  <label for="waitlist-company">Company</label>
                  <input id="waitlist-company" name="company" type="text" tabindex="-1" autocomplete="off" />
                </div>
                <input type="hidden" name="source" value="subscribe" />
                <div id="waitlist-turnstile" class="cf-turnstile flex justify-center" data-sitekey={TURNSTILE_SITEKEY} data-action={TURNSTILE_ACTION} data-appearance="interaction-only" />
                <p id="waitlist-error" class="text-xs text-red-600 text-center" role="alert" />
                <button id="waitlist-submit" type="submit" class={submitBtn}>
                  Join the Waitlist
                </button>
                <p class="text-xs text-ink-3 text-center">
                  By joining you agree we may email you about the launch — nothing else, and no
                  payment is taken now. See our{" "}
                  <a href="https://fossunited.org/privacy-policy" target="_blank" rel="noopener noreferrer" class={policyLink}>
                    Privacy Policy
                  </a>. To be removed at any time, email{" "}
                  <a href={`mailto:${REMOVAL_ADDRESS}`} class={policyLink}>{REMOVAL_ADDRESS}</a>.
                </p>
              </form>

              <div id="waitlist-success" class="hidden bg-card border-l-4 border-brand rounded-r-lg p-4 text-sm text-ink-2" aria-live="polite">
                <p class="font-semibold text-ink mb-1">You're on the list</p>
                <p>We'll email you when Season 1 opens at IndiaFOSS 2026. No spam.</p>
              </div>
            </Fragment>
          )
        }

        {
          LAUNCH_LIVE && (
            <div class="mt-4 text-center">
              <a
                href="/manage"
                class="text-xs text-ink-2 hover:text-brand-fg font-medium transition-colors duration-150 ease-out rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-fg/50"
              >
                Preview the member dashboard →
              </a>
            </div>
          )
        }
      </div>
    </div>
  </div>
</Base>

<script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>

<script>
  import { initSubscribePage } from "../lib/islands.ts";
  initSubscribePage();
</script>
