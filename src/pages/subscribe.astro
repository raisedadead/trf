---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { REMOVAL_ADDRESS, SUBSCRIBE_CTA } from "../lib/launch.ts";
import { TURNSTILE_ACTION, getSitekey } from "../lib/turnstile.ts";

const TURNSTILE_SITEKEY = getSitekey();
---

<Base>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="card">
      <div class="text-center mb-6">
        <div class="inline-block p-3 bg-brand-50 rounded-lg mb-3">
          <Icon name="heart" class="text-brand-fg" size={28} fill="currentColor" />
        </div>
        <h1 class="text-2xl font-bold text-ink mb-2 tracking-tight">
          {SUBSCRIBE_CTA}
        </h1>
        <p class="text-ink-2 text-sm">
          Support FOSS in India, from ₹10/month. We will send you an email to set up your UPI
          AutoPay mandate when Season 1 opens.
        </p>
      </div>

      <form id="waitlist-form" class="space-y-4" action="/api/waitlist" method="post">
        <div>
          <label for="waitlist-name" class="field-label">Full Name *</label>
          <input
            id="waitlist-name"
            name="name"
            type="text"
            placeholder="Your name"
            class="field"
            required
          />
        </div>
        <div>
          <label for="waitlist-email" class="field-label">Email Address *</label>
          <input
            id="waitlist-email"
            name="email"
            type="email"
            placeholder="your.email@example.com"
            class="field"
            required
          />
        </div>
        <div class="hidden" aria-hidden="true">
          <label for="waitlist-company">Company</label>
          <input
            id="waitlist-company"
            name="company"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>
        <input type="hidden" name="source" value="subscribe" />
        <div
          id="waitlist-turnstile"
          class="cf-turnstile flex justify-center"
          data-sitekey={TURNSTILE_SITEKEY}
          data-action={TURNSTILE_ACTION}
        >
        </div>
        <p id="waitlist-error" class="text-xs text-red-600 text-center" role="alert"></p>
        <button id="waitlist-submit" type="submit" class="btn btn-primary btn-block">
          Get notified
        </button>
        <p class="text-xs text-ink-3 text-center">
          By joining you agree we may email you about the launch — nothing else, and no payment is
          taken now. See our <a href="/privacy" class="inline-link">Privacy</a> page. To be removed at
          any time, email <a href={`mailto:${REMOVAL_ADDRESS}`} class="inline-link"
            >{REMOVAL_ADDRESS}</a
          >.
        </p>
      </form>

      <div id="waitlist-success" class="hidden note p-4 text-sm text-ink-2" aria-live="polite">
        <p class="font-semibold text-ink mb-1">You're on the list</p>
        <p>One email when we open. Nothing else.</p>
      </div>
    </div>
  </div>
</Base>

<script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>

<script>
  import { initSubscribePage } from "../scripts/subscribe.ts";
  initSubscribePage();
</script>
