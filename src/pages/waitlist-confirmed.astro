---
import Base from "../layouts/Base.astro";
import { REMOVAL_ADDRESS } from "../lib/launch.ts";
---

<Base>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
    <h1 class="text-2xl font-bold text-ink tracking-tight mb-3">You're on the list</h1>
    <p class="text-sm text-ink-2 mb-6">
      One email when we open, so you can set up UPI AutoPay. Nothing else, and no payment yet.
    </p>
    <p class="text-xs text-ink-3 mb-8">
      Changed your mind? Email <a
        href={`mailto:${REMOVAL_ADDRESS}`}
        class="underline hover:text-brand-fg">{REMOVAL_ADDRESS}</a
      > and we'll remove you.
    </p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/" class="btn btn-primary btn-lg"> Back to home </a>
      <a href="/projects" class="btn btn-secondary btn-lg"> See projects </a>
    </div>
  </div>
</Base>
