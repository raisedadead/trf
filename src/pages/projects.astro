---
import Base from "../layouts/Base.astro";
import { SUBSCRIBE_CTA } from "../lib/launch.ts";

// One card per `VoteProposal.state` value. A pending proposal shows the ballot
// it will offer, an open one the share each option holds, and a closed one the
// final tally with `carried` on the option the pool acted on.
interface PreviewOption {
  readonly label: string;
  readonly share: string;
  readonly carried?: boolean;
}

interface PreviewProposal {
  readonly name: string;
  readonly state: "Pending" | "Open" | "Closed";
  readonly blurb: string;
  readonly panel: string;
  readonly ballot: readonly string[];
  readonly options: readonly PreviewOption[];
}

const PREVIEW: readonly PreviewProposal[] = [
  {
    name: "Prakalpa Prathama",
    state: "Pending",
    blurb: "Nominated on the forum. The ballot opens with the season.",
    panel: "Ballot",
    ballot: ["Fund it", "Not this season"],
    options: [],
  },
  {
    name: "Prakalpa Dvitiya",
    state: "Open",
    blurb: "Contributors with 10+ months are voting on it now.",
    panel: "Vote share so far",
    ballot: [],
    options: [{ label: "150 Votes", share: "w-4/5" }],
  },
  {
    name: "Prakalpa Tritiya",
    state: "Closed",
    blurb: "Voting closed. The pool follows the result.",
    panel: "Final result",
    ballot: [],
    options: [
      { label: "200 Votes", share: "w-full", carried: true },
      { label: "60 Votes", share: "w-1/4" },
    ],
  },
];

const POOL_NOTES = [
  "Every project starts with a first rupee. Anyone can nominate one on the FOSS United forum.",
  "Contributors with 10+ months of giving vote on which of them the season funds.",
  "Results publish when the season closes, and every disbursement is listed on this page.",
] as const;
---

<Base>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <header>
      <h1
        class="mt-3 text-3xl sm:text-4xl font-extrabold text-ink mb-4 leading-[1.05] tracking-tight"
      >
        Projects worth backing, one rupee at a time
      </h1>
      <p class="text-base text-ink-2 leading-relaxed">
        Explore the open source projects your membership can help sustain, and see where the next
        rupee could make a difference.
      </p>
    </header>

    <div class="preview-stage">
      <div aria-hidden="true" class="preview-rank">
        {
          PREVIEW.map((p) => (
            <div class="preview-card" data-state={p.state.toLowerCase()}>
              <div class="preview-head">
                <span class="preview-season">SEASON 1</span>
                <span class="preview-state">{p.state}</span>
              </div>
              <p class="preview-name">{p.name}</p>
              <p class="preview-blurb">{p.blurb}</p>
              <div class="preview-panel">
                <p class="preview-panel-label">{p.panel}</p>
                {p.ballot.length > 0 && (
                  <div class="preview-ballot">
                    {p.ballot.map((label) => (
                      <span class="choice">{label}</span>
                    ))}
                  </div>
                )}
                {p.options.map((o) => (
                  <div data-carried={o.carried ? "" : undefined}>
                    <div class="preview-option">
                      <span class="preview-option-label">{o.label}</span>
                      {o.carried && <span class="preview-carried">Carried</span>}
                    </div>
                    <span class="preview-meter">
                      <span class:list={["preview-meter-fill", o.share]} />
                    </span>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <div class="preview-veil">
        <div class="card w-full max-w-md text-center shadow-card">
          <p class="text-xs font-mono font-bold tracking-wider text-brand-fg">NOTHING HERE YET</p>
          <h2 class="mt-3 text-xl font-bold text-ink tracking-tight">
            Be the first project in the pool.
          </h2>
          <p class="mt-2 text-sm text-ink-2 leading-relaxed">
            Projects will appear here when Season 1 opens. Get the email the day it does, or point
            us at a maintainer already doing the work.
          </p>
          <div class="mt-5 flex flex-col gap-3">
            <a href="/subscribe" class="btn btn-primary btn-block">{SUBSCRIBE_CTA}</a>
            <span class="w-full">
              <a
                href="https://forum.fossunited.org"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-secondary btn-block"
              >
                Nominate a project
              </a>
            </span>
          </div>
        </div>
      </div>
    </div>

    <ol class="grid gap-4 sm:grid-cols-3">
      {
        POOL_NOTES.map((n, i) => (
          <li class="pool-note">
            <span class="pool-note-index">{String(i + 1).padStart(2, "0")}</span>
            <p class="pool-note-body">{n}</p>
          </li>
        ))
      }
    </ol>
  </div>
</Base>
