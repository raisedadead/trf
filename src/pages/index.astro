---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import PixelSprite from "../components/PixelSprite.astro";
import { SEASON_ART } from "../lib/seasonArt.ts";
import { LAUNCH_LIVE } from "../lib/launch.ts";

const HOW_IT_WORKS = [
  { title: "Subscribe", desc: "Set up monthly UPI AutoPay from ₹10." },
  { title: "Pool Funds", desc: "Your contributions pool through the season." },
  { title: "Vote", desc: "Contribute 10+ months and help vote on who gets funded." },
  { title: "Disburse", desc: "Funds go to indie FOSS maintainers and builders across India." },
];

const STATS = [
  { value: "₹3cr+", label: "disbursed" },
  { value: "27+", label: "projects" },
  { value: "83+", label: "events" },
];

const FAQ = [
  {
    q: "Is the fund live yet?",
    a: "Not yet — we launch at IndiaFOSS 2026, on 26–27 September in Bengaluru. Founding contributors who join now seed Season 1's pool and lock in early voting eligibility.",
  },
  {
    q: "Why this fund?",
    a: "Free software isn't free. It can be inexpensive and sustainable when paid for by a large pool of users. Minimum is ₹10, which even most students can afford.",
  },
  {
    q: "How is this different from FOSS United grants or FLOSS/fund?",
    a: "Those are large, foundation- and company-funded grants (₹3cr+ from FOSS United; $1M a year from Zerodha's FLOSS/fund). The Rupee Fund is the community layer — thousands of ₹10s, pooled and voted on by contributors like you.",
  },
  {
    q: "Who will be funded?",
    a: "Funding based on community voting. Contributors with 10+ months get voting rights for each season.",
  },
  {
    q: "Will this fund international projects?",
    a: "No, but you can fund Indian contributors of international projects.",
  },
  {
    q: "Can I donate anonymously?",
    a: "No. We comply with all statutory requirements, so anonymous donations are not supported.",
  },
  {
    q: "How are costs handled?",
    a: "Total fund minus administrative overheads equals the funding pool. All costs documented transparently.",
  },
];

const summaryClass =
  "font-semibold text-sm cursor-pointer text-ink flex justify-between items-center transition-colors duration-150 ease-out hover:text-brand-fg rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-fg/50";
---

<Base>
  <div class="screen-enter">
    <section class="bg-white hero-glow border-b border-ink/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="mb-4">
          <span
            class="inline-flex items-center gap-2 border border-ink/15 bg-card px-3 py-1.5 text-xs leading-snug font-mono font-bold tracking-wider text-brand-fg"
          >
            <span class="w-2 h-2 bg-brand inline-block"></span>
            A FOSS United Initiative · Launching at IndiaFOSS 2026
          </span>
        </div>
        <div class="grid md:grid-cols-2 gap-8 items-stretch">
          <div class="flex flex-col">
            <h1
              class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-ink mb-4 leading-[1.05] tracking-tight"
            >
              Keep Indian open source alive — one rupee at a time
            </h1>
            <div class="mt-auto flex flex-wrap gap-3">
              <a
                href="/subscribe"
                class="bg-brand-fg text-white px-6 py-3 rounded-lg font-semibold hover:bg-brand-900 transition duration-150 ease-out active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-fg focus-visible:ring-offset-2 focus-visible:ring-offset-white inline-flex items-center gap-2"
              >
                <Icon name={LAUNCH_LIVE ? "heart" : "bell"} size={18} />
                {LAUNCH_LIVE ? "Become a Founding Contributor" : "Get notified at launch"}
              </a>
              <a
                href="/projects"
                class="bg-white text-ink border border-ink/20 px-6 py-3 rounded-lg font-semibold hover:border-brand hover:text-brand-fg transition duration-150 ease-out active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-fg focus-visible:ring-offset-2 focus-visible:ring-offset-white inline-flex items-center gap-2"
              >
                <Icon name="heart" size={18} />
                See what we fund
              </a>
            </div>
          </div>

          <div>
            <p class="mb-3 text-xs font-mono font-bold tracking-wider text-ink-3">
              <a
                href="https://fossunited.org/grants"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-brand-fg transition-colors duration-150 ease-out rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-fg/50"
              >
                FOSS United's strong history in grantmaking
              </a>
            </p>
            <div class="grid grid-cols-3 gap-2 sm:gap-4">
              {
                STATS.map((s) => (
                  <div class="bg-card p-3 sm:p-4 rounded-lg border border-ink/10 shadow-soft text-center transition duration-200 ease-out hover:-translate-y-0.5 hover:shadow-card">
                    <div class="text-xl sm:text-2xl font-mono font-bold text-brand-fg mb-1">{s.value}</div>
                    <div class="text-xs text-ink-3">{s.label}</div>
                  </div>
                ))
              }
            </div>
            <div>
              <p class="text-base text-ink-2 my-5 leading-relaxed">
                Free software isn't free. The Rupee Fund pools small monthly UPI contributions and
                routes them to indie FOSS maintainers and builders across India.
              </p>
              <p class="text-base text-ink-2 mb-5 leading-relaxed">
                Not charity — Membership in a commons.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="bg-brand-50 border-b border-brand-200">
      <div
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2.5 text-center text-xs font-medium text-brand-900"
      >
        First season opens at IndiaFOSS 2026 — 26–27 Sep, Bengaluru · Become a founding contributor
      </div>
    </div>

    <section class="py-12 bg-paper">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid gap-10 md:grid-cols-2">
          <div class="flex flex-col">
            <h2 class="text-2xl font-bold text-ink mb-5 tracking-tight">How It Works</h2>
            <div class="relative flex-1">
              <span aria-hidden="true" class="absolute bottom-4 left-4 top-4 w-px -translate-x-1/2 bg-ink/15"></span>
              <ol class="relative flex h-full flex-col justify-between gap-6">
                {
                  HOW_IT_WORKS.map((step, i) => (
                    <li class="flex gap-4">
                      <div class="relative z-10 flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-brand-fg">
                        <span class="font-mono text-sm font-bold text-white">{i + 1}</span>
                      </div>
                      <div class="pt-0.5">
                        <h3 class="mb-1 text-sm font-semibold text-ink">{step.title}</h3>
                        <p class="text-xs text-ink-3">{step.desc}</p>
                      </div>
                    </li>
                  ))
                }
              </ol>
            </div>
          </div>

          <div class="flex flex-col">
            <h2 class="text-2xl font-bold text-ink mb-5 tracking-tight">Funding Seasons</h2>
            <div class="grid grid-cols-2 gap-3">
              {
                SEASON_ART.map((s) => (
                  <div
                    class="relative flex flex-col items-center gap-2 overflow-hidden rounded-xl border border-ink/10 bg-white p-4 text-center shadow-soft transition duration-200 ease-out hover:-translate-y-0.5 hover:shadow-card"
                    style={`background-image:${s.grad}`}
                  >
                    <div class="grid h-16 w-16 shrink-0 place-items-center rounded-lg border border-ink/10 bg-card">
                      <PixelSprite rows={s.sprite} shades={s.shades} class="h-11 w-11" />
                    </div>
                    <h3 class="text-sm font-extrabold tracking-tight text-ink">{s.name}</h3>
                    <p class="text-sm font-medium uppercase tracking-wider text-ink-3">{s.months}</p>
                    <span
                      class="mt-auto rounded-md px-2 py-0.5 text-sm font-semibold text-white"
                      style={`background-color:${s.accent}`}
                    >
                      {s.duration}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-12 bg-white border-t border-ink/10">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-ink mb-5 tracking-tight">Frequently Asked Questions</h2>
        <div class="space-y-2">
          {
            FAQ.map((item) => (
              <details class="bg-card p-4 rounded-lg border border-ink/10 shadow-soft group transition-colors duration-150 ease-out hover:border-ink/20">
                <summary class={summaryClass}>
                  <span>{item.q}</span>
                  <span
                    aria-hidden="true"
                    class="text-brand-fg text-xl group-open:rotate-45 transition-transform duration-200 ease-out"
                  >
                    +
                  </span>
                </summary>
                <p class="mt-3 text-ink-2 text-xs leading-relaxed border-t border-ink/10 pt-3">{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</Base>
