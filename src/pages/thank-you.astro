---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
---

<Base>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="card text-center">
      <div class="inline-block p-3 bg-brand-50 rounded-lg mb-3">
        <Icon name="heart" class="text-brand-fg" size={32} fill="currentColor" />
      </div>
      <h1 class="text-2xl font-bold text-ink tracking-tight mb-2">You're a Founding Contributor 🎉</h1>
      <p class="text-sm text-ink-2 mb-6">
        Your UPI AutoPay mandate is set up. We'll email you when your first monthly contribution is
        collected — nothing more to do right now.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-left mb-6">
        <div class="tile">
          <Icon name="bell" class="text-brand-fg mb-2" size={20} />
          <p class="text-xs font-semibold text-ink mb-1">We'll email you</p>
          <p class="text-xs text-ink-2">at the first collection, when Season 1 opens.</p>
        </div>
        <div class="tile">
          <Icon name="heart" class="text-brand-fg mb-2" size={20} />
          <p class="text-xs font-semibold text-ink mb-1">Your name joins the wall</p>
          <p class="text-xs text-ink-2">Founding Contributors are recognised when the fund launches.</p>
        </div>
        <div class="tile">
          <Icon name="alert" class="text-brand-fg mb-2" size={20} />
          <p class="text-xs font-semibold text-ink mb-1">Spread the word</p>
          <button
            id="share-btn"
            data-share-url="https://rupeefund.org"
            class="inline-flex items-center min-h-11 text-xs text-brand-fg font-semibold hover:underline rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-fg/50"
          >
            Copy the link →
          </button>
          <span id="share-note" class="block text-xs text-ink-3 mt-1" aria-live="polite"></span>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-3">
        <a
          href="/"
          class="btn btn-primary w-full py-3 text-sm"
        >
          Back to home
        </a>
        <a
          href="/manage"
          class="btn btn-secondary w-full py-3 text-sm"
        >
          Manage contribution
        </a>
      </div>
    </div>
  </div>
</Base>

<script>
  import { initThankYou } from "../scripts/share.ts";
  initThankYou(document);
</script>
