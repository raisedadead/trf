---
import SocialIcon from "./SocialIcon.astro";
import type { SocialIconName } from "./SocialIcon.astro";

interface Social {
  slug: SocialIconName;
  name: string;
  href: string;
}

const SOCIALS: readonly Social[] = [
  { slug: "x", name: "X", href: "https://x.com/fossunited" },
  { slug: "mastodon", name: "Mastodon", href: "https://mas.to/@fossunited" },
  { slug: "linkedin", name: "LinkedIn", href: "https://in.linkedin.com/company/fossunited" },
  { slug: "youtube", name: "YouTube", href: "https://www.youtube.com/c/fossunited" },
  { slug: "telegram", name: "Telegram", href: "https://t.me/fossunited" },
];
---

<footer class="bg-ink footer-glow text-gray-400 py-10 border-t-2 border-brand">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-6">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <span class="bg-white rounded-lg p-2 inline-flex">
            <img
              src="/logo-rupee-fund.png"
              alt="The Rupee Fund"
              width="46"
              height="24"
              loading="lazy"
              decoding="async"
              class="h-6 w-auto"
            />
          </span>
          <span class="text-xs text-gray-400">by FOSS United</span>
        </div>
        <p class="text-xs leading-relaxed text-gray-400">
          Supporting small, indie FOSS maintainers and builders across India.
        </p>
      </div>
      <div>
        <h2 class="font-semibold text-white mb-3 text-sm">Quick Links</h2>
        <ul class="foot-list text-xs text-gray-400">
          <li>
            <a
              href="https://fossunited.org/about"
              target="_blank"
              rel="noopener noreferrer"
              class="foot-link -mx-2">About FOSS United</a
            >
          </li>
          <li>
            <a
              href="https://forum.fossunited.org"
              target="_blank"
              rel="noopener noreferrer"
              class="foot-link -mx-2">Community Forum</a
            >
          </li>
          <li>
            <a
              href="https://github.com/fossunited/fossunited"
              target="_blank"
              rel="noopener noreferrer"
              class="foot-link -mx-2">Source on GitHub</a
            >
          </li>
        </ul>
      </div>
      <div>
        <h2 class="font-semibold text-white mb-3 text-sm">Contact</h2>
        <p class="text-xs mb-2 text-gray-400">
          <a href="mailto:foundation@fossunited.org" class="foot-link -mx-2"
            >foundation@fossunited.org</a
          >
        </p>
        <p class="text-xs mb-2 leading-relaxed text-gray-400">
          FOSS United Foundation<br />
          D-324 Neelkanth Business Park,<br />
          Vidyavihar, Mumbai, India
        </p>
        <p class="text-xs mb-3 font-mono text-gray-400">CIN: U74999MH2016NPL288653</p>
        <div class="-ml-3 flex flex-wrap gap-x-1 gap-y-1 text-xs text-gray-400">
          {
            SOCIALS.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`FOSS United on ${s.name}`}
                class="foot-link link-plain min-w-11 justify-center"
              >
                <SocialIcon name={s.slug} />
              </a>
            ))
          }
        </div>
      </div>
    </div>
    <div class="border-t border-white/10 pt-6 text-center text-xs text-gray-400">
      <div class="mb-3 flex flex-wrap justify-center gap-x-1 gap-y-1">
        <a href="/privacy" class="foot-link">Privacy</a>
        <a href="/refunds" class="foot-link">Refunds</a>
        <a
          href="https://fossunited.org/terms-of-service"
          target="_blank"
          rel="noopener noreferrer"
          class="foot-link">Terms</a
        >
        <a
          href="https://fossunited.org/code-of-conduct"
          target="_blank"
          rel="noopener noreferrer"
          class="foot-link">Code of Conduct</a
        >
      </div>
      <p>© 2026 The Rupee Fund. A FOSS United Foundation initiative.</p>
    </div>
  </div>
</footer>
