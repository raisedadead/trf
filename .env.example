# Local values for the Rupee Fund Worker. Copy to .env (gitignored).
# direnv loads it via .envrc (dotenv). wrangler dev reads it too.
# Do NOT also keep a .dev.vars file: if it exists, wrangler ignores .env.
#
# Do NOT upload this file to the deployed Worker. Set the one real secret by hand:
#   pnpm wrangler secret put TURNSTILE_SECRET

# Turnstile: local work uses Cloudflare's always-pass test pair. Keep it that way.
# The real sitekey lives in src/lib/turnstile.ts. The value below overrides it locally.
# Never set PUBLIC_ALLOW_TEST_SITEKEY in the Workers Builds settings.
PUBLIC_ALLOW_TEST_SITEKEY="true"
PUBLIC_TURNSTILE_SITEKEY="1x00000000000000000000AA"
TURNSTILE_SECRET="1x0000000000000000000000000000000AA"
