# Local dev + prod secrets for the Rupee Fund Worker.
# Copy to .env (gitignored), fill real values. direnv loads via `.envrc` (dotenv).
# wrangler 4.x reads .env natively for `wrangler dev`; do NOT also keep a .dev.vars file
# (if .dev.vars exists, .env is ignored).
#
# Do NOT bulk-upload this file to the deployed Worker. `wrangler secret bulk .env`
# would push every key below, including the always-pass Turnstile dummy secret, and
# every JavaScript signup on rupeefund.org would then answer 403. Set the one real
# secret by hand: pnpm wrangler secret put TURNSTILE_SECRET

# Razorpay TEST-mode credentials (FOSS United dashboard -> test mode)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# Rupee-Fund recurring Plan ids (one per tier; created in the Razorpay dashboard/API)
RZP_PLAN_10="plan_xxxxxxxxxxxxxx"
RZP_PLAN_50="plan_xxxxxxxxxxxxxx"
RZP_PLAN_100="plan_xxxxxxxxxxxxxx"
RZP_PLAN_500="plan_xxxxxxxxxxxxxx"
RZP_PLAN_1000="plan_xxxxxxxxxxxxxx"

# Turnstile — local development uses Cloudflare's always-pass TEST pair below.
# Keep it that way. A real sitekey on localhost renders the production widget, which
# raises the risk score of your own address and forces the interactive checkbox. It
# also obliges the production widget to allow localhost as a domain.
# PUBLIC_ALLOW_TEST_SITEKEY is the explicit opt-in the build guard demands. Never set
# it in the Workers Builds settings — a deployed build that carries the test sitekey
# rejects every signup.
# The real sitekey is public and lives in src/lib/turnstile.ts, not here. The value
# below only overrides it for local work.
# The real secret is a Worker secret, set with `wrangler secret put TURNSTILE_SECRET`.
PUBLIC_ALLOW_TEST_SITEKEY="true"
PUBLIC_TURNSTILE_SITEKEY="1x00000000000000000000AA"
TURNSTILE_SECRET="1x0000000000000000000000000000000AA"

# Site launch gate (Astro build-time PUBLIC_ var, baked into the static build).
# Unset/false = pre-launch (waitlist only). Flip to "true" at IndiaFOSS 2026 to show UPI AutoPay.
PUBLIC_LAUNCH_LIVE="false"
