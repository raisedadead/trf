{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      "files": ["src/site/**/*.tsx"],
      "rules": {
        "react/jsx-key": "off",
        "jsx-a11y/label-has-associated-control": "off"
      }
    }
  ],
  "ignorePatterns": ["dist", ".astro", ".wrangler"]
}
